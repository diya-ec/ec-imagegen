# --- Inference provider ---
INFERENCE_PROVIDER=deepinfra
DEEPINFRA_API_KEY=changeme
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

DRAFT_MODEL=black-forest-labs/FLUX-2-klein
FINAL_MODEL=black-forest-labs/FLUX-2-max

DRAFT_PRICE_PER_IMAGE_USD=0.014
FINAL_PRICE_PER_IMAGE_USD=0.07

# --- Wizard / regen policy ---
MAX_DRAFT_VARIATIONS=3
MAX_FINAL_REGENS=1
IMAGE_SIZE=1024x102

# --- Storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=

# --- DB / queue ---
# For local development without docker-compose, SQLite is fine:
# DATABASE_URL=sqlite:///./dev.db

DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/ecimagegen

REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=imagegen


# --- HTTP behavior ---
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2.0


# --- Restyle ---
MAX_RESTYLE_VARIATIONS=3

REPLICATE_API_TOKEN=changeme
RESTYLE_MODEL=black-forest-labs/flux-2-klein-9b-base
RESTYLE_PRICE_PER_IMAGE_USD=0.04
RESTYLE_POLL_TIMEOUT_SECONDS=180