# --- Inference provider ---
INFERENCE_PROVIDER=deepinfra
DEEPINFRA_API_KEY=changeme
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DRAFT_MODEL=black-forest-labs/FLUX-2-klein
FINAL_MODEL=black-forest-labs/FLUX-2-max
DRAFT_PRICE_PER_IMAGE_USD=0.014
FINAL_PRICE_PER_IMAGE_USD=0.07

# --- Wizard / regen policy ---
MAX_DRAFT_VARIATIONS=3
MAX_FINAL_REGENS=1
IMAGE_SIZE=1024x1024

# --- Storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=

# --- DB / queue ---
# For local dev without docker-compose, SQLite is fine:
# DATABASE_URL=sqlite:///./dev.db
DATABASE_URL=postgresql+psycopg://ecimagegen:ecimagegen@localhost:5432/ecimagegen
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=imagegen

# --- HTTP behavior towards DeepInfra ---
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2.0
